---
// Raíz ES: las 33 páginas de procedimiento y los 133 artículos del blog conservan su URL exacta del WordPress.
import ProcedurePage from '../components/ProcedurePage.astro';
import BlogPost from '../components/BlogPost.astro';
import { procedures, blogPosts } from '../lib/data';

export function getStaticPaths() {
  return [
    ...procedures.map((p) => ({ params: { slug: p.id }, props: { kind: 'proc', id: p.id } })),
    ...blogPosts.map((b) => ({ params: { slug: b.slug }, props: { kind: 'post', id: b.slug } })),
  ];
}
const { kind, id } = Astro.props;
const post = blogPosts.find((b) => b.slug === id);
---
{kind === 'proc' ? <ProcedurePage id={id} lang="es" /> : <BlogPost post={post!} />}
