---
import ProcedurePage from '../../components/ProcedurePage.astro';
import { procedures } from '../../lib/data';

export function getStaticPaths() {
  return procedures.map((p) => ({ params: { slug: p.slugEn }, props: { id: p.id } }));
}
const { id } = Astro.props;
---
<ProcedurePage id={id} lang="en" />
