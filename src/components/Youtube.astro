---
// Fachada: no carga nada de YouTube hasta el clic (rendimiento).
import { site } from '../data/site';
interface Props { title?: string }
const { title = site.youtube.title } = Astro.props;
const id = site.youtube.id;
const doc = `<style>*{margin:0}a{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#000 url(https://i.ytimg.com/vi/${id}/hqdefault.jpg) center/cover}span{width:68px;height:48px;border-radius:12px;background:#c4302b;display:flex;align-items:center;justify-content:center}span::after{content:"";border-style:solid;border-width:10px 0 10px 18px;border-color:transparent transparent transparent #fff}</style><a href="https://www.youtube-nocookie.com/embed/${id}?autoplay=1"><span></span></a>`;
---
<div class="yt"><iframe title={title} srcdoc={doc} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
